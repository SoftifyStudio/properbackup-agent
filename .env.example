# ProperBackup Agent — Environment Variables
# Copy this file to .env and fill in the values from your ProperBackup panel.

# Required: Your user ID (from panel → Settings)
PROPERBACKUP_USER_ID=

# Required: Your server ID (from panel → Add machine)
PROPERBACKUP_SERVER_ID=

# Required: Buffer URL (your ProperBackup backend)
PROPERBACKUP_BUFFER_URL=http://host.docker.internal:7100

# Required: Upload token (from panel → Settings)
PROPERBACKUP_UPLOAD_TOKEN=

# Required: Encryption password (KEEP THIS SAFE — needed for restore)
PROPERBACKUP_ENCRYPTION_PASSWORD=

# Optional: How often to scan for changes (seconds, minimum 60)
PROPERBACKUP_POLL_INTERVAL=120
